<%# locals: (pocket:, account:, url:) %>

<%= styled_form_with model: [ account, pocket ], url: url, class: "space-y-4" do |f| %>
  <div class="flex justify-center">
    <%= render "goals/color_picker", form: f, colors: Pocket::COLORS, icons: Pocket::ICONS %>
  </div>

  <%= f.text_field :name,
    label: t("pockets.form.name"),
    required: true,
    autofocus: true,
    placeholder: t("pockets.form.name_placeholder") %>

  <%= f.text_area :description,
    label: t("pockets.form.description"),
    placeholder: t("pockets.form.description_placeholder"),
    rows: 2 %>

  <div style="<%= "opacity:0.5;pointer-events:none" if pocket.tag_id.present? %>">
    <%= f.money_field :allocated_amount,
      label: t("pockets.form.allocated_amount"),
      required: !pocket.tag_id.present?,
      disable_currency: true,
      disabled: pocket.tag_id.present? %>
  </div>

  <%# Composition sketch (PR #2892 discussion): no free tag picker. "Auto-fill"
      is a plain toggle — checking it generates a dedicated tag this pocket
      owns outright, the same reasoning as Goal's own tracking tag. Picking an
      existing tag risks landing on one already used for something else,
      silently backdating its whole history into the pocket. %>
  <div class="rounded-lg bg-surface-inset px-3 py-2.5 space-y-2">
    <label class="flex items-center gap-2 cursor-pointer">
      <% if pocket.tag_id.present? %>
        <%= check_box_tag "pocket[link_new_tag]", "1", true, disabled: true, class: "checkbox checkbox--light shrink-0" %>
      <% else %>
        <%= hidden_field_tag "pocket[link_new_tag]", "0", id: nil %>
        <%= check_box_tag "pocket[link_new_tag]", "1", false, class: "checkbox checkbox--light shrink-0" %>
      <% end %>
      <span class="text-sm font-medium text-primary"><%= t("pockets.form.auto_fill_tag") %></span>
    </label>

    <% if pocket.tag_id.present? %>
      <p class="text-xs text-secondary flex items-center gap-1.5">
        <%= icon("zap", size: "xs", class: "text-warning shrink-0") %>
        <%= render DS::Pill.new(label: pocket.tag.name, marker: false, size: :sm, custom_color: pocket.tag.color) %>
      </p>

      <%= f.select :fill_direction,
        Pocket.fill_directions.keys.map { |d| [ t("pockets.form.fill_direction.#{d}"), d ] },
        { label: t("pockets.form.fill_direction_label") },
        {} %>
    <% end %>

    <p class="text-xs text-secondary"><%= t("pockets.form.auto_fill_hint") %></p>
  </div>

  <% if account.pockets.any? || pocket.persisted? %>
    <div class="bg-container-inset rounded-lg p-3 text-sm text-secondary flex items-center gap-2">
      <%= icon("info", size: "sm", class: "shrink-0") %>
      <span>
        <%= t("pockets.form.free_balance_hint",
              amount: format_money(Money.new(account.free_balance + (pocket.allocated_amount_was || 0), account.currency))) %>
      </span>
    </div>
  <% end %>

  <div class="flex gap-2 justify-end">
    <%= f.submit t("pockets.form.save") %>
  </div>
<% end %>
