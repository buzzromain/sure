<%# locals: (budget_category:) %>

<% currency = Money::Currency.new(budget_category.budget.currency) %>

<div id="<%= dom_id(budget_category, :form) %>" class="w-full flex gap-3">
  <div class="w-1 h-3 rounded-xl mt-1" style="background-color: <%= budget_category.category.color %>"></div>

  <div class="text-sm mr-3">
    <p class="text-primary font-medium mb-0.5"><%= budget_category.category.display_name %></p>

    <p class="text-secondary privacy-sensitive"><%= t("budget_categories.budget_category_form.monthly_average", amount: budget_category.median_monthly_expense_money.format(precision: 0)) %></p>

    <% if budget_category.adjusted? %>
      <p class="text-secondary privacy-sensitive"><%= t("budget_categories.budget_category.adjustments_balance", amount: format_money(budget_category.adjustments_balance_money)) %></p>
    <% end %>
  </div>

  <div class="ml-auto flex items-center gap-1.5">
    <%# Outside the allocation form on purpose: a button inside it would
        submit the amount field on click. Hidden for an envelope with nothing
        to give — an inheriting subcategory, or one left at zero. %>
    <% if budget_category[:budgeted_spending].to_d.positive? %>
      <button type="button"
              class="text-subdued hover:text-primary p-1 rounded-md focus-ring"
              title="<%= t("budget_categories.move.button_title") %>"
              aria-label="<%= t("budget_categories.move.button_title") %>"
              data-action="budget-move#open"
              data-budget-move-from-id-param="<%= budget_category.id %>"
              data-budget-move-from-name-param="<%= budget_category.category.display_name %>"
              data-budget-move-category-id-param="<%= budget_category.category_id %>"
              data-budget-move-parent-id-param="<%= budget_category.category.parent_id %>"
              data-budget-move-available-param="<%= budget_category.budgeted_spending_money.format %>">
        <%= icon("arrow-left-right", size: "sm") %>
      </button>
    <% end %>

    <%# Reserve equivalent of the move button above, sourced from
        adjustments_balance instead of budgeted_spending. Hidden for the same
        reason: nothing to send away. %>
    <% if budget_category.adjustments_balance.to_d.positive? %>
      <button type="button"
              class="text-subdued hover:text-primary p-1 rounded-md focus-ring"
              title="<%= t("budget_categories.move_reserve.button_title") %>"
              aria-label="<%= t("budget_categories.move_reserve.button_title") %>"
              data-action="budget-reserve-move#open"
              data-budget-reserve-move-from-id-param="<%= budget_category.id %>"
              data-budget-reserve-move-from-name-param="<%= budget_category.category.display_name %>"
              data-budget-reserve-move-category-id-param="<%= budget_category.category_id %>"
              data-budget-reserve-move-parent-id-param="<%= budget_category.category.parent_id %>"
              data-budget-reserve-move-available-param="<%= budget_category.adjustments_balance_money.format %>">
        <%= icon("shuffle", size: "sm") %>
      </button>
    <% end %>

    <%# No visibility guard tied to a current balance: an opening balance is
        a one-time catch-up entry, not something the envelope needs to have
        first -- see BudgetAdjustment.record_opening_balance!. Hidden only
        for an inheriting subcategory, which has no reserve of its own to
        credit (same gate adjustments_balance itself reads through). %>
    <% unless budget_category.inherits_parent_budget? %>
      <button type="button"
              class="text-subdued hover:text-primary p-1 rounded-md focus-ring"
              title="<%= t("budget_categories.opening_balance.button_title") %>"
              aria-label="<%= t("budget_categories.opening_balance.button_title") %>"
              data-action="budget-opening-balance#open"
              data-budget-opening-balance-category-id-param="<%= budget_category.category_id %>"
              data-budget-opening-balance-category-name-param="<%= budget_category.category.display_name %>">
        <%= icon("piggy-bank", size: "sm") %>
      </button>
    <% end %>

    <%= form_with model: [budget_category.budget, budget_category], url: budget_budget_category_path(budget_category.budget, budget_category, **budget_owner_query), data: { controller: "auto-submit-form preserve-focus budget-category-contribution" } do |f| %>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5" title="<%= t("budget_categories.budget_category_form.rollover_title") %>">
          <%= label_tag dom_id(budget_category, :rollover_enabled),
                        t("budget_categories.budget_category_form.rollover_label"),
                        class: "text-xs text-secondary cursor-pointer" %>
          <%= render DS::Toggle.new(
                id: dom_id(budget_category, :rollover_enabled),
                name: "budget_category[rollover_enabled]",
                checked: budget_category.rollover_enabled?,
                data: { auto_submit_form_target: "auto" }
              ) %>
        </div>

        <div class="form-field w-[110px]" title="<%= t("budget_categories.budget_category_form.contribution_title") %>">
          <%= f.select :contribution_mode,
                       %w[manual fixed complete_to].map { |mode| [ t("budget_categories.budget_category_form.contribution_modes.#{mode}"), mode ] },
                       {},
                       id: dom_id(budget_category, :contribution_mode),
                       class: "form-field__input text-xs",
                       "aria-label": t("budget_categories.budget_category_form.contribution_title"),
                       data: { auto_submit_form_target: "auto", budget_category_contribution_target: "modeSelect",
                               action: "change->budget-category-contribution#refresh" } %>
        </div>

        <div class="form-field w-[120px] <%= "hidden" unless budget_category.fixed? %>" data-budget-category-contribution-target="amountField">
          <div class="flex items-center privacy-sensitive privacy-sensitive-interactive">
            <span class="text-secondary text-sm mr-2"><%= currency.symbol %></span>
            <%= f.number_field :contribution_amount,
                              class: "form-field__input text-right [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none",
                              step: currency.step,
                              id: dom_id(budget_category, :contribution_amount),
                              min: 0,
                              data: { auto_submit_form_target: "auto" } %>
          </div>
        </div>

        <div class="form-field w-[120px] <%= "hidden" if budget_category.fixed? %>" data-budget-category-contribution-target="budgetedField">
          <div class="flex items-center privacy-sensitive privacy-sensitive-interactive">
            <span class="text-secondary text-sm mr-2"><%= currency.symbol %></span>
            <%= f.number_field :budgeted_spending,
                              class: "form-field__input text-right [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none",
                              placeholder: budget_category.subcategory? ? t("budget_categories.budget_category_form.shared_placeholder") : "0",
                              step: currency.step,
                              id: dom_id(budget_category, :budgeted_spending),
                              min: 0,
                              disabled: budget_category.complete_to?,
                              data: { auto_submit_form_target: "auto" },
                              title: budget_category.complete_to? ? t("budget_categories.budget_category_form.complete_to_title") : (budget_category.subcategory? ? t("budget_categories.budget_category_form.shared_title") : nil) %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
