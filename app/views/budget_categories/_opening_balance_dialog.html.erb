<%# locals: (budget:) %>

<%# One dialog for the page, same reasoning as _move_dialog: every row's
    button fills in the same hidden category_id rather than each row
    carrying its own copy of this form. %>
<%= render DS::Dialog.new(
      auto_open: false,
      disable_frame: true,
      width: "sm",
      data: { budget_opening_balance_target: "dialog" }
    ) do |dialog| %>
  <% dialog.with_header(title: t("budget_categories.opening_balance.dialog_title")) %>

  <% dialog.with_body do %>
    <%= form_with url: record_opening_balance_budget_budget_categories_path(budget, **budget_owner_query),
                  method: :post,
                  class: "space-y-4",
                  data: { action: "turbo:submit-end->budget-opening-balance#submitEnd" } do |f| %>
      <%= hidden_field_tag "category_id", nil, data: { budget_opening_balance_target: "categoryId" } %>

      <p class="text-sm text-secondary">
        <span class="text-primary font-medium" data-budget-opening-balance-target="categoryName"></span>
      </p>

      <div class="space-y-1">
        <%= label_tag "budget_adjustment_opening_balance_amount", t("budget_categories.opening_balance.amount_label"), class: "text-sm text-secondary" %>
        <%= number_field_tag "budget_adjustment_opening_balance[amount]", nil,
                             id: "budget_adjustment_opening_balance_amount",
                             step: Money::Currency.new(budget.currency).step,
                             min: Money::Currency.new(budget.currency).step,
                             required: true,
                             autocomplete: "off",
                             class: "form-field__input w-full text-right tabular-nums privacy-sensitive",
                             data: { budget_opening_balance_target: "amount" } %>
      </div>

      <div class="space-y-1">
        <%= label_tag "budget_adjustment_opening_balance_note", t("budget_categories.opening_balance.note_label"), class: "text-sm text-secondary" %>
        <%= text_field_tag "budget_adjustment_opening_balance[note]", nil,
                           id: "budget_adjustment_opening_balance_note",
                           autocomplete: "off",
                           class: "form-field__input w-full",
                           data: { budget_opening_balance_target: "note" } %>
      </div>

      <%# Household budgets only: a funding_category-linked Goal always reads
          the household chain (Goal#current_funding_budget_category), never a
          personal one -- offering this on a personal budget would create a
          Goal whose balance can never resolve to anything coherent. No kind
          picker, same reasoning as the pocket form's own target section: this
          stays kind: one_off, no target_date. A maintained/months-of-expenses
          goal, or a target added later, still goes through the full "Ajouter
          un objectif" flow (BudgetCategoryGoalsController), unchanged. %>
      <% unless budget.user %>
        <%= render DS::Disclosure.new(title: t("budget_categories.opening_balance.add_target"), open: false, variant: :inline) do %>
          <div class="space-y-1 pt-2">
            <%= label_tag "budget_adjustment_opening_balance_target_amount", t("goals.form.fields.target_amount"), class: "text-sm text-secondary" %>
            <%= number_field_tag "budget_adjustment_opening_balance[target_amount]", nil,
                                 id: "budget_adjustment_opening_balance_target_amount",
                                 step: Money::Currency.new(budget.currency).step,
                                 min: Money::Currency.new(budget.currency).step,
                                 autocomplete: "off",
                                 class: "form-field__input w-full text-right tabular-nums privacy-sensitive",
                                 data: { budget_opening_balance_target: "targetAmount" } %>
          </div>
        <% end %>
      <% end %>

      <div class="flex justify-end gap-2 pt-1">
        <%= render DS::Button.new(text: t("budget_categories.opening_balance.cancel"),
                                  variant: "secondary",
                                  type: "button",
                                  data: { action: "budget-opening-balance#close" }) %>
        <%= render DS::Button.new(text: t("budget_categories.opening_balance.submit"),
                                  type: "submit",
                                  data: { budget_opening_balance_target: "submit" }) %>
      </div>
    <% end %>
  <% end %>
<% end %>
