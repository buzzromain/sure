<%# locals: (budget:, budget_categories:) %>

<%# Reserve equivalent of _move_dialog -- one dialog for the whole page, same
    reasoning: the list can hold dozens of categories and they would all be
    identical but for the source. %>
<%= render DS::Dialog.new(
      auto_open: false,
      disable_frame: true,
      width: "sm",
      data: { budget_reserve_move_target: "dialog" }
    ) do |dialog| %>
  <% dialog.with_header(title: t("budget_categories.move_reserve.dialog_title")) %>

  <% dialog.with_body do %>
    <%= form_with url: move_reserve_budget_budget_categories_path(budget, **budget_owner_query),
                  method: :post,
                  class: "space-y-4",
                  data: { action: "turbo:submit-end->budget-reserve-move#submitEnd" } do |f| %>
      <%= hidden_field_tag "from_id", nil, data: { budget_reserve_move_target: "fromId" } %>

      <p class="text-sm text-secondary">
        <span class="text-primary font-medium" data-budget-reserve-move-target="fromName"></span>
        ·
        <span class="tabular-nums privacy-sensitive" data-budget-reserve-move-target="available"></span>
      </p>

      <div class="space-y-1">
        <%= label_tag "budget_adjustment_move_amount", t("budget_categories.move_reserve.amount_label"), class: "text-sm text-secondary" %>
        <%= number_field_tag "budget_adjustment_move[amount]", nil,
                             id: "budget_adjustment_move_amount",
                             step: Money::Currency.new(budget.currency).step,
                             min: Money::Currency.new(budget.currency).step,
                             required: true,
                             autocomplete: "off",
                             class: "form-field__input w-full text-right tabular-nums privacy-sensitive",
                             data: { budget_reserve_move_target: "amount" } %>
      </div>

      <div class="space-y-1">
        <%= label_tag "reserve_to_id", t("budget_categories.move_reserve.to_label"), class: "text-sm text-secondary" %>
        <%= select_tag "to_id",
                       safe_join(budget_categories.map { |bc|
                         tag.option(bc.category.display_name,
                                    value: bc.id,
                                    data: { category_id: bc.category_id, parent_id: bc.category.parent_id })
                       }),
                       id: "reserve_to_id",
                       class: "form-field__input w-full",
                       data: { budget_reserve_move_target: "toSelect" } %>
      </div>

      <p class="hidden text-sm text-secondary" data-budget-reserve-move-target="noDestination">
        <%= t("budget_categories.move_reserve.no_destination") %>
      </p>

      <div class="flex justify-end gap-2 pt-1">
        <%= render DS::Button.new(text: t("budget_categories.move_reserve.cancel"),
                                  variant: "secondary",
                                  type: "button",
                                  data: { action: "budget-reserve-move#close" }) %>
        <%= render DS::Button.new(text: t("budget_categories.move_reserve.submit"),
                                  type: "submit",
                                  data: { budget_reserve_move_target: "submit" }) %>
      </div>
    <% end %>
  <% end %>
<% end %>
