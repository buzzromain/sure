<%# locals: (goal:, consumed:) %>

<%# POC: no embedded transaction list — Pocket's own card doesn't list rows
    either, just a status line and a link out. The full list already exists
    at the other end of that link (the tag filter); repeating it here just to
    repeat it added a second place for the two to quietly disagree. %>
<% consumed_total = consumed.sum { |entry| entry.amount.to_d } %>
<% unaccounted = goal.consumption_unaccounted_for(consumed_total) %>

<div class="bg-container rounded-xl shadow-border-xs p-4">
  <div class="flex items-center justify-between gap-3">
    <div class="min-w-0 flex items-center gap-2">
      <div class="w-8 h-8 rounded-full bg-surface-inset inline-flex items-center justify-center text-secondary shrink-0">
        <%= icon("receipt", size: "sm") %>
      </div>
      <div class="min-w-0">
        <%# consumed_amount only means something for a one-off goal: a reserve
            is drawn down and refilled, never "spent", so it stays 0 no matter
            how many tagged transactions moved its earmark either way — this
            line would read as "$0 used" while the earmark visibly moved. %>
        <% if consumed.any? && goal.one_off? %>
          <p class="text-sm text-primary tabular-nums privacy-sensitive truncate">
            <%= t("goals.consumed_outflows.summary_compact",
                  total: goal.consumed_amount_money.format(precision: 0),
                  transactions: t("goals.consumed_outflows.transactions", count: consumed.size)) %>
            <% if unaccounted.positive? %>
              <span class="text-subdued">
                <%= t("goals.consumed_outflows.unaccounted", amount: Money.new(unaccounted, goal.currency).format(precision: 0)) %>
              </span>
            <% end %>
          </p>
        <% end %>
        <p class="text-xs text-secondary flex items-center gap-1 truncate">
          <% if goal.tag %>
            <%= icon("zap", size: "xs", class: "text-warning shrink-0") %>
            <span class="truncate"><%= t("goals.consumed_outflows.tag_hint", tag: goal.tag.name) %></span>
          <% else %>
            <span><%= t("goals.consumed_outflows.no_tag_hint") %></span>
          <% end %>
        </p>
      </div>
    </div>

    <% if goal.tag %>
      <%= render DS::Link.new(
            variant: "ghost",
            icon: "list",
            href: transactions_path(q: { tags: [ goal.tag.name ] }),
            aria: { label: t("goals.consumed_outflows.open_in_transactions") },
            frame: :_top
          ) %>
    <% end %>
  </div>
</div>
